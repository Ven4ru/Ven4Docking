<Application x:Class="Ven4Docking.Editor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Ven4Docking.Editor.Services"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <l:VisibleWhen x:Key="Vis"/>
            <l:Not x:Key="NotConv"/>
            <l:StateBrush x:Key="StateBrushConv"/>
            <l:LocFormat x:Key="LocFormat"/>
            <l:LocKey x:Key="LocKey"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
