<UserControl x:Class="Ven4Docking.Editor.Views.NotifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Ven4Docking.Editor.Services">
    <DockPanel Margin="24,18,24,18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{l:L Section_Notify}" Style="{StaticResource H1}" Margin="0,0,0,2"/>
            <TextBlock Text="{l:L Notify_Subtitle}" Style="{StaticResource Hint}"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- left: switches and Windows access -->
            <StackPanel Margin="0,0,16,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Content="{l:L Notify_Enabled}" IsChecked="{Binding Enabled}" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:L Notify_EnabledHint}" Style="{StaticResource Hint}" Margin="26,0,0,8"/>
                        <CheckBox Content="{l:L Notify_WallCountsOnly}" IsChecked="{Binding WallCountsOnly}"/>
                        <TextBlock Text="{l:L Notify_WallCountsOnlyHint}" Style="{StaticResource Hint}" Margin="26,0,0,8"/>
                        <CheckBox Content="{l:L Notify_NightFlash}" IsChecked="{Binding NightFlash}"/>
                        <TextBlock Text="{l:L Notify_NightFlashHint}" Style="{StaticResource Hint}" Margin="26,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:L Notify_Access}" Style="{StaticResource H2}"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding AccessOk, Converter={StaticResource StateBrushConv}}"/>
                            <TextBlock Text="{Binding AccessText}" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="290"/>
                        </StackPanel>
                        <TextBlock Text="{l:L Notify_AccessWhere}" Style="{StaticResource Hint}" Margin="0,8,0,8"/>
                        <Button Content="{l:L Notify_OpenSettings}" Command="{Binding OpenWindowsSettingsCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- right: apps -->
            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="{l:L Common_Refresh}"
                                Command="{Binding LoadCommand}"/>
                        <TextBlock Text="{l:L Notify_Apps}" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:L Notify_AppsHint}" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Foreground="{DynamicResource StatusWarning}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding Message, Converter={StaticResource Vis}}"/>
                    <TextBlock DockPanel.Dock="Top" Text="{l:L Notify_NoApps}" Style="{StaticResource Hint}"
                               Visibility="{Binding HasApps, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    <ListBox ItemsSource="{Binding Apps}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <ComboBox DockPanel.Dock="Right" Width="180" VerticalAlignment="Center" Margin="12,0,0,0"
                                              ItemsSource="{Binding Modes}" SelectedValuePath="Id" SelectedValue="{Binding Mode}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Aumid}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
