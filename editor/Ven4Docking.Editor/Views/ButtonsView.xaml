<UserControl x:Class="Ven4Docking.Editor.Views.ButtonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Ven4Docking.Editor.Services"
             xmlns:v="clr-namespace:Ven4Docking.Editor.Views">
    <DockPanel Margin="24,18,24,18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{l:L Section_Buttons}" Style="{StaticResource H1}" Margin="0,0,0,2"/>
            <TextBlock Text="{l:L Buttons_Subtitle}" Style="{StaticResource Hint}"/>
        </StackPanel>

        <!-- spec 1.1 §2: input does not reach elevated windows (UIPI), some anti-cheats ignore it -->
        <Border DockPanel.Dock="Top" Style="{StaticResource WarnNote}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource StatusWarning}"
                           VerticalAlignment="Top" Margin="0,1,10,0"/>
                <TextBlock Text="{l:L Buttons_Warning}" TextWrapping="Wrap" FontSize="12"/>
            </DockPanel>
        </Border>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Command="{Binding AddKeysCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Padding="14,0" Content="{l:L Buttons_AddKeys}"/>
            <Button Command="{Binding AddTextCommand}" Margin="0,0,8,8" Content="{l:L Buttons_AddText}"/>
            <Button Command="{Binding AddMacroCommand}" Margin="0,0,8,8" Content="{l:L Buttons_AddMacro}"/>
            <Button Command="{Binding AddMicCommand}" Margin="0,0,8,8" Content="{l:L Buttons_AddMic}"/>
            <Button Command="{Binding AddAudioOutCommand}" Margin="0,0,8,8" Content="{l:L Buttons_AddAudioOut}"/>
            <Button Command="{Binding AddDiscordCommand}" Margin="0,0,8,8" Content="{l:L Buttons_AddDiscord}" ToolTip="{l:L Buttons_DiscordHint}"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Foreground="{DynamicResource StatusInfo}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Visibility="{Binding Message, Converter={StaticResource Vis}}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- the list, drag to reorder -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{l:L Buttons_ListHint}" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="{Binding HasActions, Converter={StaticResource Vis}, ConverterParameter=invert}">
                    <TextBlock Text="{l:L Buttons_Empty}" Style="{StaticResource Hint}"/>
                </Border>
                <ListBox x:Name="List" ItemsSource="{Binding Actions}" SelectedItem="{Binding Selected}" AllowDrop="True"
                         PreviewMouseLeftButtonDown="List_PreviewMouseDown" PreviewMouseMove="List_PreviewMouseMove" Drop="List_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE76F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextSecondary}" Cursor="SizeNS"/>
                                <Border DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0" CornerRadius="6" Background="{DynamicResource SurfaceRaised}">
                                    <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentColor}"/>
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Margin="8,0,0,0"
                                           Foreground="{DynamicResource StatusDanger}" ToolTip="{Binding Problem}"
                                           Visibility="{Binding HasProblem, Converter={StaticResource Vis}}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- selected action -->
            <Border Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                <Grid>
                    <TextBlock Text="{l:L Buttons_SelectHint}" Style="{StaticResource Hint}"
                               Visibility="{Binding Selected, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Selected, Converter={StaticResource Vis}}">
                        <StackPanel DataContext="{Binding Selected}" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentColor}"/>
                                <TextBlock Text="{Binding KindText}" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{l:L Buttons_Title}" Style="{StaticResource Hint}" Margin="0,10,0,4"/>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}"/>

                            <!-- keys -->
                            <StackPanel Visibility="{Binding IsKeys, Converter={StaticResource Vis}}">
                                <TextBlock Text="{l:L Buttons_Keys}" Style="{StaticResource Hint}" Margin="0,10,0,4"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE894;" Margin="6,0,0,0"
                                            ToolTip="{l:L Buttons_ClearKeys}" Command="{Binding ClearKeysCommand}"/>
                                    <v:HotkeyBox Combination="{Binding Keys}" ToolTip="{l:L Hotkey_ToolTip}"/>
                                </DockPanel>
                                <TextBlock Text="{l:L Buttons_KeysHint}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                <Border Style="{StaticResource Note}" Margin="0,8,0,0" Visibility="{Binding IsDiscord, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{l:L Buttons_DiscordHint}" TextWrapping="Wrap" FontSize="12"/>
                                </Border>
                            </StackPanel>

                            <!-- text -->
                            <StackPanel Visibility="{Binding IsText, Converter={StaticResource Vis}}">
                                <TextBlock Text="{l:L Buttons_Text}" Style="{StaticResource Hint}" Margin="0,10,0,4"/>
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="140" VerticalScrollBarVisibility="Auto" MaxLength="2000"/>
                                <TextBlock Text="{Binding TextCounter}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                <TextBlock Text="{l:L Buttons_TextHint}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- macro -->
                            <StackPanel Visibility="{Binding IsMacro, Converter={StaticResource Vis}}">
                                <TextBlock Text="{l:L Buttons_Steps}" Style="{StaticResource Hint}" Margin="0,10,0,6"/>
                                <ItemsControl ItemsSource="{Binding Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Height="26" Width="26" Margin="0,0,4,0" ToolTip="{l:L Common_Up}"
                                                                    Command="{Binding DataContext.StepUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Height="26" Width="26" Margin="0,0,4,0" ToolTip="{l:L Common_Down}"
                                                                    Command="{Binding DataContext.StepDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Height="26" Width="26" ToolTip="{l:L Common_Delete}"
                                                                    Command="{Binding DataContext.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12">
                                                            <Run Text="{Binding Number, Mode=OneWay}"/><Run Text=". "/><Run Text="{Binding KindText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <DockPanel Margin="0,6,0,0" Visibility="{Binding IsKeys, Converter={StaticResource Vis}}">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE894;" Margin="6,0,0,0"
                                                                ToolTip="{l:L Buttons_ClearKeys}" Command="{Binding ClearKeysCommand}"/>
                                                        <v:HotkeyBox Combination="{Binding Keys}" ToolTip="{l:L Hotkey_ToolTip}"/>
                                                    </DockPanel>
                                                    <TextBox Margin="0,6,0,0" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap"
                                                             MinHeight="56" MaxLength="2000" Visibility="{Binding IsText, Converter={StaticResource Vis}}"/>
                                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal" Visibility="{Binding IsWait, Converter={StaticResource Vis}}">
                                                        <TextBox Width="90" Text="{Binding Wait, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="{l:L Buttons_WaitUnit}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                    <!-- ItemTemplate, not DisplayMemberPath: the ComboBox template shows SelectionBoxItemTemplate -->
                                                    <ComboBox Margin="0,6,0,0" ItemsSource="{Binding Apps}" SelectedValuePath="Id"
                                                              SelectedValue="{Binding Launch}" Visibility="{Binding IsLaunch, Converter={StaticResource Vis}}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource StatusDanger}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Visibility="{Binding Problem, Converter={StaticResource Vis}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:L Buttons_AddStep}" Style="{StaticResource Hint}" Margin="0,4,0,4"/>
                                <ItemsControl ItemsSource="{Binding DataContext.StepKinds, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Height="26" Padding="8,0" Margin="0,0,4,4" FontWeight="Normal" Content="{Binding Title}"
                                                    Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:L Buttons_StepsHint}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- mic -->
                            <TextBlock Text="{l:L Buttons_MicHint}" Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Visibility="{Binding IsMic, Converter={StaticResource Vis}}"/>

                            <!-- audioOut -->
                            <StackPanel Visibility="{Binding IsAudioOut, Converter={StaticResource Vis}}">
                                <DockPanel Margin="0,10,0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Height="26" Width="26"
                                            ToolTip="{l:L Common_Refresh}"
                                            Command="{Binding DataContext.LoadDevicesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <TextBlock Text="{l:L Buttons_Devices}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="{Binding DataContext.DevicesMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Foreground="{DynamicResource StatusWarning}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                                           Visibility="{Binding DataContext.DevicesMessage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}"/>
                                <ItemsControl ItemsSource="{Binding DeviceChoices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxWidth="340"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:L Buttons_FewDevices}" Foreground="{DynamicResource StatusWarning}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding FewDevices, Converter={StaticResource Vis}}"/>
                                <TextBlock Text="{l:L Buttons_DevicesHint}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource StatusDanger}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding Problem, Converter={StaticResource Vis}}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"><Run Text="id: "/><Run Text="{Binding Id, Mode=OneWay}"/></TextBlock>
                            <TextBlock Text="{l:L Buttons_BlockHint}" Style="{StaticResource Hint}" Margin="0,6,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="{l:L Common_Up}" Margin="0,0,4,0"
                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="{l:L Common_Down}" Margin="0,0,8,0"
                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Content="{l:L Common_Delete}" Style="{StaticResource DangerButton}"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
