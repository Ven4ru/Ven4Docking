<UserControl x:Class="Ven4Docking.Editor.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Ven4Docking.Editor.Services">
    <StackPanel Margin="24,18,24,18" MaxWidth="680" HorizontalAlignment="Left">
        <TextBlock Text="{l:L Section_About}" Style="{StaticResource H1}"/>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <!-- Venchik with a phone (assets/icon, spec §14). -->
                <Image DockPanel.Dock="Left" Width="96" Height="96" Margin="0,0,18,0"
                       Source="/Assets/ven4docking-256.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="Bold"><Run Text="Ven4"/><Run Text="Docking" Foreground="{DynamicResource AccentColor}"/></TextBlock>
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Hint}" FontSize="13"/>
                    <TextBlock Text="{l:L About_Text}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{l:L About_CheckUpdates}" Command="{Binding CheckUpdatesCommand}" Padding="14,0"/>
                    <Button Content="{Binding InstallText}" Command="{Binding InstallUpdateCommand}" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Padding="14,0" Visibility="{Binding Available, Converter={StaticResource Vis}}"/>
                    <!-- the release page stays as the fallback way -->
                    <Button Content="{l:L About_Install}" Command="{Binding OpenReleaseCommand}" Margin="8,0,0,0"
                            Visibility="{Binding ReleaseUrl, Converter={StaticResource Vis}}"/>
                </StackPanel>
                <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <StackPanel Margin="0,10,0,0" Visibility="{Binding DownloadText, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:L Update_Cancel}" Command="{Binding CancelDownloadCommand}" Height="26" Padding="10,0"
                                Margin="10,0,0,0" Visibility="{Binding Downloading, Converter={StaticResource Vis}}"/>
                        <ProgressBar Value="{Binding DownloadPercent}" Maximum="100" VerticalAlignment="Center"
                                     IsIndeterminate="{Binding DownloadSizeKnown, Converter={StaticResource NotConv}}"
                                     Visibility="{Binding Downloading, Converter={StaticResource Vis}}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding DownloadText}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding InstallError}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource StatusDanger}"
                           Visibility="{Binding InstallError, Converter={StaticResource Vis}}"/>
                <TextBlock Text="{l:L Update_Hint}" Style="{StaticResource Hint}" Margin="0,10,0,0"
                           Visibility="{Binding Available, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{l:L Ven4verse_Line}"/>
                <Button Style="{StaticResource LinkButton}" Content="{l:L Ven4verse_Link}" Command="{Binding OpenVen4verseCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                <TextBlock Text="{l:L About_Privacy}" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
