<UserControl x:Class="Ven4Docking.Editor.Views.AiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Ven4Docking.Editor.Services">
    <DockPanel Margin="24,18,24,18">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="{l:L Common_Refresh}" Command="{Binding LoadCommand}" VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock Text="{l:L Section_Ai}" Style="{StaticResource H1}" Margin="0,0,0,2"/>
                <TextBlock Text="{l:L Ai_Subtitle}" Style="{StaticResource Hint}"/>
            </StackPanel>
        </DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Note}">
            <TextBlock Text="{l:L Ai_SafetyNote}" TextWrapping="Wrap" FontSize="12"/>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Style="{StaticResource Hint}" Margin="0,0,0,8"
                   Visibility="{Binding Message, Converter={StaticResource Vis}}"/>
        <ItemsControl ItemsSource="{Binding Sources}" MaxWidth="760" HorizontalAlignment="Left">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled}" Content="{l:L Ai_Show}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Hint}">
                                    <Run Text="{Binding InstalledText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding LastDataText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
