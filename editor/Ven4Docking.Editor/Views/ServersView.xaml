<UserControl x:Class="Ven4Docking.Editor.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Ven4Docking.Editor.Services">
    <DockPanel Margin="24,18,24,18">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="{l:L Servers_Add}" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Padding="14,0"/>
            <StackPanel>
                <TextBlock Text="{l:L Section_Servers}" Style="{StaticResource H1}" Margin="0,0,0,2"/>
                <TextBlock Text="{l:L Servers_Subtitle}" Style="{StaticResource Hint}"/>
            </StackPanel>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,16,0"
                    Visibility="{Binding HasServers, Converter={StaticResource Vis}, ConverterParameter=invert}">
                <TextBlock Text="{l:L Servers_Empty}" Style="{StaticResource Hint}"/>
            </Border>
            <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding Selected}" Margin="0,0,16,0"
                     Visibility="{Binding HasServers, Converter={StaticResource Vis}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding Selected, Converter={StaticResource Vis}}">
                <StackPanel DataContext="{Binding Selected}" MaxWidth="560" HorizontalAlignment="Left" Width="520">
                    <TextBlock Text="{l:L Servers_Name}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:L Servers_Host}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Host, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:L Servers_Port}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Port, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{l:L Servers_User}" Style="{StaticResource Hint}" Margin="0,8,0,4"/>
                    <TextBox Text="{Binding User, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="{l:L Servers_Key}" Style="{StaticResource Hint}" Margin="0,8,0,4"/>
                    <TextBox Text="{Binding Key, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="{l:L Servers_KeyHint}" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{l:L Servers_Test}" Style="{StaticResource PrimaryButton}" Padding="14,0" Margin="0,0,8,0"
                                Command="{Binding DataContext.TestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Button Content="{l:L Common_Delete}" Style="{StaticResource DangerButton}"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{Binding TestOk, Converter={StaticResource StateBrushConv}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
