<UserControl x:Class="Ven4Docking.Editor.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Ven4Docking.Editor.Services">
    <DockPanel Margin="24,18,24,18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{l:L Section_Apps}" Style="{StaticResource H1}" Margin="0,0,0,2"/>
            <TextBlock Text="{l:L Apps_Subtitle}" Style="{StaticResource Hint}"/>
        </StackPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Command="{Binding ShowStartMenuCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,0" Content="{l:L Apps_FromStart}"/>
            <Button Command="{Binding AddExeCommand}" Margin="0,0,8,0" Content="{l:L Apps_AddExe}"/>
            <Button Command="{Binding AddUrlCommand}" Margin="0,0,8,0" Content="{l:L Apps_AddUrl}"/>
            <Button Command="{Binding AddCommandCommand}" Margin="0,0,8,0" Content="{l:L Apps_AddCommand}"/>
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource StatusSuccess}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </WrapPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- the list, drag to reorder -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{l:L Apps_ReorderHint}" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="{Binding HasApps, Converter={StaticResource Vis}, ConverterParameter=invert}">
                    <TextBlock Text="{l:L Apps_Empty}" Style="{StaticResource Hint}"/>
                </Border>
                <ListBox x:Name="List" ItemsSource="{Binding Apps}" SelectedItem="{Binding Selected}" AllowDrop="True"
                         PreviewMouseLeftButtonDown="List_PreviewMouseDown" PreviewMouseMove="List_PreviewMouseMove" Drop="List_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE76F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextSecondary}" Cursor="SizeNS"/>
                                <Grid DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0">
                                    <Border CornerRadius="6" Background="{DynamicResource SurfaceRaised}"/>
                                    <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentColor}"/>
                                    <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Target}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Start menu picker -->
            <Border Grid.Column="1" Width="320" Margin="16,0,0,0" Style="{StaticResource Card}"
                    Visibility="{Binding IsStartMenuOpen, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:L Apps_StartMenu}" Style="{StaticResource H2}"/>
                    <TextBox DockPanel.Dock="Top" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="{l:L Apps_Search}"/>
                    <TextBlock DockPanel.Dock="Top" Text="{l:L Apps_Scanning}" Style="{StaticResource Hint}" Visibility="{Binding Scanning, Converter={StaticResource Vis}}"/>
                    <ListBox ItemsSource="{Binding StartMenuView}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" Height="26" Width="26"
                                            ToolTip="{l:L Apps_Add}"
                                            Command="{Binding DataContext.AddFromStartMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Folder}" Style="{StaticResource Hint}" FontSize="10.5"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- selected app -->
            <Border Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource Card}" VerticalAlignment="Top">
                <Grid>
                    <TextBlock Text="{l:L Apps_SelectHint}" Style="{StaticResource Hint}"
                               Visibility="{Binding Selected, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    <StackPanel DataContext="{Binding Selected}" Visibility="{Binding Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding KindText}" Style="{StaticResource Hint}"/>
                        <TextBlock Text="{l:L Apps_Title}" Style="{StaticResource Hint}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="{l:L Apps_Target}" Style="{StaticResource Hint}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding Target, UpdateSourceTrigger=LostFocus}"/>
                        <StackPanel Visibility="{Binding HasArgs, Converter={StaticResource Vis}}">
                            <TextBlock Text="{l:L Apps_Args}" Style="{StaticResource Hint}" Margin="0,8,0,4"/>
                            <TextBox Text="{Binding Args, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"><Run Text="id: "/><Run Text="{Binding Id, Mode=OneWay}"/></TextBlock>
                        <TextBlock Text="{l:L Apps_SecurityNote}" Style="{StaticResource Hint}" Margin="0,8,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="{l:L Common_Up}" Margin="0,0,4,0"
                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="{l:L Common_Down}" Margin="0,0,4,0"
                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            <Button Content="{l:L Apps_RefreshIcon}" Margin="0,0,8,0"
                                    Command="{Binding DataContext.RefreshIconCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            <Button Content="{l:L Common_Delete}" Style="{StaticResource DangerButton}"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
