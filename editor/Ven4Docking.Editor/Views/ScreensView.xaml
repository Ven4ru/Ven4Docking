<UserControl x:Class="Ven4Docking.Editor.Views.ScreensView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Ven4Docking.Editor.Services"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="276"/>
        </Grid.ColumnDefinitions>

        <!-- Left: screens + palette -->
        <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock DockPanel.Dock="Top" Text="{l:L Screens_Title}" Style="{StaticResource H2}"/>
            <StackPanel DockPanel.Dock="Top">
                <ListBox ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}" MaxHeight="230">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding BlockCountText}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBox Text="{Binding SelectedScreen.Name, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,6"
                         ToolTip="{l:L Screens_RenameHint}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" Command="{Binding AddScreenCommand}" ToolTip="{l:L Screens_Add}" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Command="{Binding MoveScreenUpCommand}" ToolTip="{l:L Common_Up}" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Command="{Binding MoveScreenDownCommand}" ToolTip="{l:L Common_Down}" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding DeleteScreenCommand}" ToolTip="{l:L Screens_Delete}"/>
                </StackPanel>
                <TextBlock Text="{l:L Screens_Templates}" Style="{StaticResource Hint}" Margin="0,12,0,4"/>
                <ItemsControl ItemsSource="{Binding Templates}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Height="26" Padding="8,0" Margin="0,0,4,4" FontWeight="Normal"
                                    Content="{Binding Title}"
                                    Command="{Binding DataContext.ApplyTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Id}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{l:L Screens_Palette}" Style="{StaticResource H2}" Margin="0,14,0,2"/>
                <TextBlock Text="{l:L Screens_PaletteHint}" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Palette}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,6,6" Padding="8,7" CornerRadius="6" Cursor="SizeAll"
                                    Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    MouseMove="Palette_MouseMove" MouseLeftButtonDown="Palette_MouseDown" Tag="{Binding}"
                                    ToolTip="{l:L Screens_PaletteItemHint}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentColor}"/>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="12"/>
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Hint}" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Center: phone preview with grid overlay -->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource H2}" Margin="0">
                    <Run Text="{l:L Screens_Preview}"/><Run Text=" · "/><Run Text="{Binding SelectedScreen.Name, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{l:L Screens_PreviewHint}" Style="{StaticResource Hint}"/>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource WarnNote}" Margin="0,10,0,0"
                    Visibility="{Binding IssuesText, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="{l:L Screens_CannotSave}" FontWeight="SemiBold" Foreground="{DynamicResource StatusDanger}"/>
                    <TextBlock Text="{Binding IssuesText}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Foreground="{DynamicResource StatusWarning}" Margin="0,8,0,0"
                       Visibility="{Binding Message, Converter={StaticResource Vis}}"/>

            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" HorizontalAlignment="Center">
                <Border Background="#05070B" CornerRadius="22" Padding="16" BorderBrush="#2A3240" BorderThickness="2">
                    <Grid Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" ClipToBounds="True">
                        <wv2:WebView2CompositionControl x:Name="Preview" DefaultBackgroundColor="#0B0E14"/>
                        <Border x:Name="NoWebView" Background="#0B0E14" Visibility="Collapsed">
                            <TextBlock Text="{l:L Screens_NoWebView}" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Canvas x:Name="GridLines" IsHitTestVisible="False"/>
                        <Canvas x:Name="Overlay" Background="Transparent" AllowDrop="True"
                                DragOver="Overlay_DragOver" Drop="Overlay_Drop" MouseLeftButtonDown="Overlay_MouseDown">
                            <ItemsControl ItemsSource="{Binding SelectedScreen.Blocks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding PxLeft}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding PxTop}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding PxWidth}" Height="{Binding PxHeight}">
                                            <Border x:Name="Box" Margin="3" CornerRadius="10" BorderThickness="1.5" Cursor="SizeAll"
                                                    Background="#14FFFFFF" BorderBrush="{DynamicResource AccentSoftBorder}"
                                                    MouseLeftButtonDown="Block_MouseDown" MouseMove="Block_MouseMove" MouseLeftButtonUp="Block_MouseUp"
                                                    Tag="move">
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="6,2"
                                                        CornerRadius="4" Background="#C0101722">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource AccentColor}"/>
                                                        <TextBlock Text="{Binding Title}" FontSize="11" Margin="5,0,0,0" Foreground="#E2E8F0"/>
                                                        <TextBlock Text="{Binding GeometryText}" FontSize="10" Margin="6,0,0,0" Foreground="#8A9BB5"/>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <Border x:Name="Handle" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,1,1" CornerRadius="4" Background="{DynamicResource AccentColor}" Cursor="SizeNWSE"
                                                    Visibility="Hidden" Tag="resize"
                                                    MouseLeftButtonDown="Block_MouseDown" MouseMove="Block_MouseMove" MouseLeftButtonUp="Block_MouseUp">
                                                <TextBlock Text="&#xE740;" Style="{StaticResource Icon}" FontSize="9" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource AccentForeground}"/>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                                <Setter TargetName="Box" Property="BorderThickness" Value="2.5"/>
                                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BlockFill}"/>
                                                <Setter TargetName="Handle" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource StatusDanger}"/>
                                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource StatusDangerSoft}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Grid>
                </Border>
            </Viewbox>
        </DockPanel>

        <!-- Right: block properties -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="16,0,0,0" VerticalAlignment="Stretch">
            <Grid>
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource Vis}, ConverterParameter=invert}">
                    <TextBlock Text="{l:L Props_Title}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{l:L Props_Empty}" Style="{StaticResource Hint}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedBlock.Glyph}" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Text="{Binding SelectedBlock.Title}" Style="{StaticResource H2}" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding SelectedBlock.Id}" Style="{StaticResource Hint}" Margin="8,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{l:L Props_Position}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="6"/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SelectedBlock.X, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="4" Text="{Binding SelectedBlock.Y, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Row="2" Text="{l:L Props_W}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedBlock.W, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{l:L Props_H}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding SelectedBlock.H, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>

                        <StackPanel Visibility="{Binding IsClock, Converter={StaticResource Vis}}" Margin="0,0,0,8">
                            <CheckBox Content="{l:L Opts_ClockWeather}" IsChecked="{Binding ClockWeather}"/>
                            <CheckBox Content="{l:L Opts_Clock24}" IsChecked="{Binding Clock24}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding OptionChoicesTitle, Converter={StaticResource Vis}}" Margin="0,0,0,8">
                            <TextBlock Text="{Binding OptionChoicesTitle}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding OptionChoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{l:L Opts_EmptyList}" Style="{StaticResource Hint}"
                                       Visibility="{Binding OptionChoices.Count, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                        </StackPanel>

                        <TextBlock Text="{l:L Opts_Json}" Style="{StaticResource Hint}" Margin="0,4,0,4"/>
                        <TextBox Text="{Binding OptsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Mono}"
                                 AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="{Binding OptsError}" Foreground="{DynamicResource StatusDanger}" FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding OptsError, Converter={StaticResource Vis}}"/>
                        <Button Content="{l:L Opts_Apply}" Command="{Binding ApplyOptsCommand}" HorizontalAlignment="Left" Margin="0,6,0,16"/>

                        <Button Content="{l:L Props_Delete}" Command="{Binding DeleteBlockCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
