<UserControl x:Class="Ven4Docking.Editor.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Ven4Docking.Editor.Services">
    <UserControl.Resources>
        <DataTemplate x:Key="BrandLineTemplate">
            <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Margin="0,3,8,0"
                           VerticalAlignment="Top" Foreground="{DynamicResource AccentColor}"/>
                <StackPanel>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"/>
                    <TextBlock Text="{l:L Brand_MayDiffer}" Style="{StaticResource Hint}" FontStyle="Italic" FontSize="11"
                               Visibility="{Binding Unconfirmed, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
        <Style x:Key="Field" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,18" MaxWidth="980" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding CloseCommand}" ToolTip="{l:L Common_Close}" VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock Text="{Binding StepCounter}" Style="{StaticResource Hint}" Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource H1}" Margin="0,2,0,6"/>
                <ProgressBar Maximum="7" Value="{Binding Step, Mode=OneWay}" Width="360" HorizontalAlignment="Left"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. method -->
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource Vis}}">
                    <Border Style="{StaticResource Note}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE839;" Style="{StaticResource Icon}" FontSize="22" Margin="0,0,14,0"
                                       VerticalAlignment="Top" Foreground="{DynamicResource AccentColor}"/>
                            <StackPanel>
                                <TextBlock Text="{l:L Cable_Title}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{l:L Cable_Text}" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{l:L Wizard_Method}" Style="{StaticResource H2}" Margin="0,4,0,8"/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource ChoiceRadio}" GroupName="m" IsChecked="{Binding IsUsb}" Width="300">
                            <StackPanel>
                                <TextBlock Text="{l:L Wizard_Usb}" FontWeight="SemiBold"/>
                                <TextBlock Text="{l:L Wizard_UsbHint}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChoiceRadio}" GroupName="m" IsChecked="{Binding IsWifi}" Width="300">
                            <StackPanel>
                                <TextBlock Text="{l:L Wizard_Wifi}" FontWeight="SemiBold"/>
                                <TextBlock Text="{l:L Wizard_WifiHint}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>

                    <Border Style="{StaticResource Card}" Margin="0,8,0,12" Visibility="{Binding AdbReady, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <StackPanel>
                            <TextBlock Text="{l:L Adb_NeedTitle}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{l:L Adb_NeedText}" Style="{StaticResource Hint}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{l:L Adb_Download}" Command="{Binding EnsureAdbCommand}" Padding="14,0"/>
                                <ProgressBar Width="200" Margin="12,0,0,0" Value="{Binding DownloadProgress}" VerticalAlignment="Center"
                                             Visibility="{Binding Busy, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Visibility="{Binding AdbReady, Converter={StaticResource Vis}}" Margin="0,4,0,8">
                        <Run Text="{l:L Adb_Found}"/><Run Text=" "/><Run Text="{Binding AdbPath, Mode=OneWay}"/>
                    </TextBlock>

                    <Border Style="{StaticResource Card}" Visibility="{Binding IsWifi, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="{l:L Wifi_Title}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{l:L Wifi_Steps}" Style="{StaticResource Hint}"/>
                            <TextBlock Text="{l:L Wifi_PairAddress}" Style="{StaticResource Field}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="200" Text="{Binding PairHostPort, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{l:L Wifi_Code}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                <TextBox Width="100" Text="{Binding PairCode, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="{l:L Wifi_Pair}" Command="{Binding PairCommand}" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{l:L Wifi_ConnectAddress}" Style="{StaticResource Field}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="200" Text="{Binding ConnectHostPort, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="{l:L Wifi_Connect}" Command="{Binding ConnectCommand}" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2. device + brand -->
                <Grid Visibility="{Binding IsStep2, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{l:L Wizard_Brand}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Width="260" ItemsSource="{Binding BrandList}" SelectedItem="{Binding ManualBrand}" DisplayMemberPath="Name"/>
                        </StackPanel>
                        <TextBlock Text="{l:L Brand_Developer}" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding DeveloperLines}" ItemTemplate="{StaticResource BrandLineTemplate}"/>
                        <TextBlock Text="{l:L Brand_Toggles}" Style="{StaticResource H2}" Margin="0,8,0,8"
                                   Visibility="{Binding ToggleLines.Count, Converter={StaticResource Vis}}"/>
                        <ItemsControl ItemsSource="{Binding ToggleLines}" ItemTemplate="{StaticResource BrandLineTemplate}"/>
                        <StackPanel Visibility="{Binding IsWifi, Converter={StaticResource Vis}}">
                            <TextBlock Text="{l:L Brand_Wifi}" Style="{StaticResource H2}" Margin="0,8,0,8"/>
                            <ItemsControl ItemsSource="{Binding WifiLines}" ItemTemplate="{StaticResource BrandLineTemplate}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshDevicesCommand}" ToolTip="{l:L Common_Refresh}"/>
                                <TextBlock Text="{l:L Wizard_Devices}" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource Hint}"><Run Text="{Binding Serial, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding State, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding DeviceText}" Foreground="{DynamicResource StatusSuccess}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="{Binding BrandName, Converter={StaticResource Vis}}">
                                <Run Text="{l:L Wizard_BrandDetected}"/><Run Text=" "/><Run Text="{Binding BrandName, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. install + settings -->
                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource Vis}}">
                    <TextBlock Text="{l:L Wizard_Apk}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="{l:L Common_Browse}" Command="{Binding BrowseApkCommand}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding ApkPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <Button Content="{l:L Wizard_RunSetup}" Command="{Binding RunSetupCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="16,0"/>
                    <TextBlock Text="{l:L Wizard_SetupHint}" Style="{StaticResource Hint}" Margin="0,6,0,10"/>
                    <ItemsControl ItemsSource="{Binding SetupRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,7" Margin="0,0,0,4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding StateGlyph}" Style="{StaticResource Icon}" Width="24" FontSize="13"
                                                   Foreground="{Binding State, Converter={StaticResource StateBrushConv}}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Visibility="{Binding Detail, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource WarnNote}" Margin="0,8,0,8" Visibility="{Binding PermissionDenied, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="{l:L Wizard_DeniedTitle}" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding PermissionLines}" ItemTemplate="{StaticResource BrandLineTemplate}" Margin="0,6,0,0"/>
                            <Button Content="{l:L Common_Retry}" Command="{Binding RetryCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{l:L Brand_KeepAlive}" Style="{StaticResource H2}" Margin="0,12,0,8"/>
                    <ItemsControl ItemsSource="{Binding KeepAliveLines}" ItemTemplate="{StaticResource BrandLineTemplate}"/>
                </StackPanel>

                <!-- 4. token -->
                <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource Vis}}" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="{l:L Wizard_TokenText}" Style="{StaticResource Hint}" FontSize="13"/>
                    <TextBlock Text="{l:L Wizard_PhoneName}" Style="{StaticResource Field}"/>
                    <TextBox Text="{Binding PhoneName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{l:L Wizard_AgentUrl}" Style="{StaticResource Field}"/>
                    <TextBox Text="{Binding AgentUrl, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="{l:L Wizard_SendToken}" Command="{Binding SendTokenCommand}" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Padding="16,0"/>
                </StackPanel>

                <!-- 5. WebView -->
                <StackPanel Visibility="{Binding IsStep5, Converter={StaticResource Vis}}" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="{l:L WebView_Text}" Style="{StaticResource Hint}" FontSize="13"/>
                    <TextBlock Text="{Binding WebViewText}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,10"/>
                    <Border Style="{StaticResource WarnNote}" Visibility="{Binding WebViewOld, Converter={StaticResource Vis}}">
                        <TextBlock Text="{l:L WebView_Old}" TextWrapping="Wrap"/>
                    </Border>
                    <Button Content="{l:L WebView_Check}" Command="{Binding CheckWebViewCommand}" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- 6. charge limit -->
                <StackPanel Visibility="{Binding IsStep6, Converter={StaticResource Vis}}" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="{l:L Charge_Text}" Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding ChargeLines}" ItemTemplate="{StaticResource BrandLineTemplate}"/>
                </StackPanel>

                <!-- 7. done -->
                <StackPanel Visibility="{Binding IsStep7, Converter={StaticResource Vis}}" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="&#xE930;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource StatusSuccess}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{l:L Done_Text}" TextWrapping="Wrap" FontSize="14" Margin="0,12,0,16"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:L Ven4verse_Line}" FontSize="13"/>
                            <Button Style="{StaticResource LinkButton}" Content="{l:L Ven4verse_Link}" Command="{Binding OpenVen4verseCommand}" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Button Content="{l:L Common_Finish}" Command="{Binding CloseCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="20,0"/>
                </StackPanel>

                <CheckBox x:Name="ShowLog" Content="{l:L Wizard_ShowLog}" Margin="0,16,0,4"/>
                <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Mono}" Height="140" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Visibility="{Binding IsChecked, ElementName=ShowLog, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- footer -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:L Common_Back}" Command="{Binding BackCommand}" Margin="0,0,8,0" Padding="16,0"/>
                <Button Content="{l:L Common_Next}" Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}" Padding="20,0"/>
            </StackPanel>
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{DynamicResource StatusInfo}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource StatusDanger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>
    </Grid>
</UserControl>
