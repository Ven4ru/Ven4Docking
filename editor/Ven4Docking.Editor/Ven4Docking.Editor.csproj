<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK projection is required by WebView2CompositionControl (WPF content can overlay the preview). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>Ven4Docking</AssemblyName>
    <RootNamespace>Ven4Docking.Editor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ven4Docking.Core\Ven4Docking.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\brands.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
