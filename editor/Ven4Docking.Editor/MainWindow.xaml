<Window x:Class="Ven4Docking.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Ven4Docking.Editor.Services"
        xmlns:vm="clr-namespace:Ven4Docking.Editor.ViewModels"
        xmlns:v="clr-namespace:Ven4Docking.Editor.Views"
        Title="Ven4Docking" Icon="/Assets/ven4docking.ico" Width="1440" Height="900" MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PhonesViewModel}"><v:PhonesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScreensViewModel}"><v:ScreensView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppsViewModel}"><v:AppsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ButtonsViewModel}"><v:ButtonsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServersViewModel}"><v:ServersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotifyViewModel}"><v:NotifyView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiViewModel}"><v:AiView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><v:AboutView/></DataTemplate>

        <Style x:Key="RailList" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,10">
                            <Grid>
                                <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="-12,0,0,0" CornerRadius="2"
                                        Background="{DynamicResource AccentColor}" Visibility="Hidden"/>
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBackground}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left rail of sections -->
        <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,18,12,22">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentSoftBackground}"
                            BorderBrush="{DynamicResource AccentSoftBorder}" BorderThickness="1">
                        <TextBlock Text="&#xE8EA;" Style="{StaticResource Icon}" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentColor}" FontSize="17"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="Bold">
                            <Run Text="Ven4"/><Run Text="Docking" Foreground="{DynamicResource AccentColor}"/>
                        </TextBlock>
                        <TextBlock Text="{l:L App_Subtitle}" Style="{StaticResource Hint}" FontSize="10.5"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StorageText}" Style="{StaticResource Hint}" FontSize="10.5"
                           Margin="20,0,12,16" TextTrimming="CharacterEllipsis" ToolTip="{Binding StorageText}"/>
                <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                         ItemContainerStyle="{StaticResource RailList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Width="22" FontSize="15"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center" Text="{Binding Title}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                <DockPanel VerticalAlignment="Center" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding UndoCommand}" Margin="0,0,8,0" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/>
                                <TextBlock Text="{l:L Top_Undo}" Margin="6,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="18,0" Content="{l:L Top_Save}"/>
                    </StackPanel>

                    <TextBlock Text="{l:L Top_Phone}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="210" ItemsSource="{Binding Session.Phones}" SelectedItem="{Binding SelectedPhone}"
                              DisplayMemberPath="Name"/>

                    <Border Margin="16,0,0,0" CornerRadius="14" Padding="10,5" Background="{DynamicResource SurfaceRaised}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding AgentOnline, Converter={StaticResource StateBrushConv}}"/>
                            <TextBlock Text="{Binding AgentText}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Margin="8,0,0,0"
                                       Foreground="{DynamicResource StatusWarning}" ToolTip="{l:L Firewall_Title}"
                                       Visibility="{Binding FirewallWarning, Converter={StaticResource Vis}}"/>
                            <Button Content="{l:L Agent_Start}" Command="{Binding StartAgentCommand}" Height="22" Padding="8,0" Margin="10,0,0,0"
                                    FontSize="11" Visibility="{Binding AgentOnline, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}" Margin="16,0" VerticalAlignment="Center" FontSize="12"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccess}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource StatusDanger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1">
                <!-- A newer release was found by the check at start: «Доступна версия X.Y.Z · Обновить». -->
                <Border Style="{StaticResource Note}" Margin="20,12,20,0" AutomationProperties.Name="{Binding About.BannerText}"
                        Visibility="{Binding About.ShowBanner, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip="{l:L Update_Hide}" Command="{Binding About.HideBannerCommand}"/>
                        <Button DockPanel.Dock="Right" Content="{l:L Update_BannerInstall}" Command="{Binding UpdateFromBannerCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="16,0" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentColor}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding About.BannerText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <!-- Firewall rule missing or blocked: the agent runs, but the phone cannot reach the PC (spec §13). -->
                <Border Style="{StaticResource WarnNote}" Margin="20,12,20,0" AutomationProperties.Name="{l:L Firewall_Title}"
                        Visibility="{Binding FirewallWarning, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:L Firewall_Fix}" Command="{Binding FixFirewallCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="16,0" Margin="12,0,0,0" VerticalAlignment="Center"
                                ToolTip="{l:L Firewall_FixHint}"/>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource StatusWarning}"
                                   VerticalAlignment="Top" Margin="0,1,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:L Firewall_Title}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding FirewallText}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding FirewallNote}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                       Visibility="{Binding FirewallNote, Converter={StaticResource Vis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{DynamicResource StatusWarning}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FirewallNoteIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusDanger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>

            <ContentControl Grid.Row="2" Content="{Binding SelectedSection.ViewModel}" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
